10 REM SCHUB DEMO - RISC-V FUNCTIONS FROM BASIC (NEEDS RVDEMO.MER)
20 MODE 40:BLOAD "RVDEMO":SCHUB 262144
30 PRINT "6 * 7 =";SCHUB(0,6,7)
40 PRINT "4321 * 1234 =";SCHUB(0,4321,1234)
50 T=CLOCK(0):P=SCHUB(1,20000):T=CLOCK(0)-T
60 PRINT "PRIMES BELOW 20000:";P;"IN";T;"FRAMES"
70 PRINT "STATUS:";SCHUB(-1)
80 PRINT "PRESS A KEY TO FILL THE SCREEN"
90 GET K$:IF K$="" THEN 90
100 N=SCHUB(2,42,7)
110 GET K$:IF K$="" THEN 110
120 SCHUB 0:CLS:PRINT N;"CELLS FILLED, SCHUB IS OFF"
